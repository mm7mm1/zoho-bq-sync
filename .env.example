# Copy to .env for local runs:  set -a; source .env; set +a
# Never commit .env. On Cloud Run the OAuth JSON comes from Secret Manager (see docs/deployment.md).

# --- Zoho OAuth (pick ONE source) --------------------------------------------------------
# a) one JSON file {"client_id","client_secret","refresh_token","accounts_url","api_domain"}
ZOHO_OAUTH_JSON_FILE=./secrets/zoho-oauth.json
# b) the same JSON read from Secret Manager via the API
# ZOHO_OAUTH_JSON_SECRET=projects/<project>/secrets/zoho-oauth
# c) individual values (local only)
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=

# --- Zoho endpoints ----------------------------------------------------------------------
# us | eu | in | au | jp | cn | ca | sa | us-developer | us-sandbox | eu-developer
ZOHO_DC=eu-developer
# Explicit overrides win over ZOHO_DC and over values in the OAuth JSON
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
# ZOHO_API_DOMAIN=https://developer.zohoapis.eu
ZOHO_API_VERSION=v8

# --- Zoho client behaviour ---------------------------------------------------------------
ZOHO_PAGE_SIZE=200
ZOHO_TIMEOUT_SECONDS=60
ZOHO_MAX_RETRIES=5
ZOHO_BACKOFF_BASE_SECONDS=1
ZOHO_BACKOFF_MAX_SECONDS=60
# Hard stop per run so a bug can never drain the org's shared 24h API credits
ZOHO_MAX_API_CALLS_PER_RUN=2000

# --- What to sync ------------------------------------------------------------------------
# Empty = every standard and custom module the API supports
ZOHO_MODULES=Wedding_Bookings
ZOHO_EXCLUDE_MODULES=
# Module.Field pairs to skip
ZOHO_EXCLUDE_FIELDS=
# ZohoModuleOrSubformApiName=bigquery_table
TABLE_NAME_OVERRIDES=Booked_Services=wedding_bookings_services

# --- Sync behaviour ----------------------------------------------------------------------
# Re-read this many seconds before the checkpoint (MERGE makes the overlap idempotent)
SYNC_OVERLAP_SECONDS=300
# true = when a new column appears, re-sync the whole module to fill it for existing records
BACKFILL_ON_NEW_FIELDS=false
# Full resync refuses to soft-delete more than this fraction of active rows
MAX_DELETE_FRACTION=0.5
STORE_RAW_JSON=true
FAIL_ON_RECONCILIATION_MISMATCH=false

# --- Google Cloud identity ---------------------------------------------------------------
# Required, no default: a guessed ID could be someone else's project. Deploy scripts read it too.
GCP_PROJECT=
# Recommended when this machine also runs other GCP work: pin this repo's shell to its own
# gcloud configuration and its own ADC file, so neither the global gcloud account nor the
# global ADC is ever used here (setup: docs/demo_walkthrough.md, step 5).
# CLOUDSDK_ACTIVE_CONFIG_NAME=zoho-bq-sync
# GOOGLE_APPLICATION_CREDENTIALS=${HOME}/.config/gcloud-zoho-bq-sync/application_default_credentials.json

# --- BigQuery ----------------------------------------------------------------------------
BQ_DATASET=zoho_crm
BQ_STAGING_DATASET=zoho_crm_staging
BQ_LOCATION=EU
BQ_STAGING_EXPIRATION_HOURS=24

# --- Logging -----------------------------------------------------------------------------
# json for Cloud Logging, text for a readable terminal during the demo
LOG_FORMAT=text
LOG_LEVEL=INFO
